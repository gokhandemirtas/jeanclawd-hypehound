RESEND_API_KEY=re_...
RESEND_INBOX_ID=...

# OpenAI-compatible inference — swap base URL and model to change provider
# LM Studio (default):
INFERENCE_BASE_URL=http://localhost:1234/v1
INFERENCE_MODEL=local-model
# Ollama: INFERENCE_BASE_URL=http://localhost:11434/v1
# Remote OpenAI: INFERENCE_BASE_URL=https://api.openai.com/v1

DB_PATH=hypehound.db
DIGEST_HOUR=7

# TTS endpoint — any OpenAI-compatible /synthesize server
# jeanclawd-voicebox (default): cd ../jeanclawd-voicebox && uv run jeanclawd-voicebox
VOICEBOX_URL=http://localhost:8000
TTS_VOICE_SINGLE=aiden
TTS_VOICE_MALE=aiden
TTS_VOICE_FEMALE=serena
PODCAST_INTRO=""

# Cloudflare Pages deployment (used by --publish flag)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=hypehound-web
PUBLISH_OWNER_EMAIL=you@example.com  # redacted from sources panel on published episodes